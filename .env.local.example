# Copy this file to .env.local and fill in your real values
# (Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Sthamly Sahayak (AI assistant) — powers /sahayak and app/api/sahayak.
# Get a free key from https://aistudio.google.com/ (no credit card
# needed for Gemini Flash models). NEVER prefix this with NEXT_PUBLIC_
# — it must stay server-only, or anyone could steal and abuse it.
GEMINI_API_KEY=your-gemini-api-key
