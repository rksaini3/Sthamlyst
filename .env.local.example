# Copy this file to .env.local and fill in your real values
# (Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Sthamly Sahayak (AI assistant) — powers /sahayak and app/api/sahayak.
# Get a free key from https://aistudio.google.com/ (no credit card
# needed for Gemini Flash models). NEVER prefix this with NEXT_PUBLIC_
# — it must stay server-only, or anyone could steal and abuse it.
GEMINI_API_KEY=your-gemini-api-key

# Payments (Razorpay) — powers Bazaar checkout. Get keys from
# https://dashboard.razorpay.com/ → Settings → API Keys.
# RAZORPAY_KEY_SECRET must stay server-only — never NEXT_PUBLIC_.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Optional but recommended: Supabase service role key, used by the
# payment API routes to read/confirm orders reliably server-side.
# Supabase → Project Settings → API → service_role (keep this SECRET,
# it bypasses Row Level Security — never expose it to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
