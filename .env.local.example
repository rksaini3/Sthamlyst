# Copy this file to .env.local and fill in your real values
# (Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional but recommended: Supabase service role key, used by
# server-side API routes (/api/audit, /api/optimize) to read/write
# data reliably, bypassing Row Level Security.
# Supabase → Project Settings → API → service_role (keep this SECRET
# — never expose it to the browser, never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Visibility Audit — powers /api/audit. Single key routes to both
# OpenAI and Perplexity (sonar) models via OpenRouter.
# Get a key from https://openrouter.ai/keys (add wallet credits there).
# NEVER prefix with NEXT_PUBLIC_ — server-only.
OPENROUTER_API_KEY=your-openrouter-api-key

# Google AI Overview check — powers /api/audit's Serper.dev search.
# Get a key from https://serper.dev/
SERPER_API_KEY=your-serper-api-key

# Payments (Razorpay) — powers the "Fix Now" paid optimization button
# on /dashboard. Get keys from https://dashboard.razorpay.com/ →
# Settings → API Keys.
# RAZORPAY_KEY_SECRET must stay server-only — never NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
