const STORAGE_KEY = 'sthamly_audit_history';

export interface AuditHistoryEntry {
  auditId: string;
  brandName: string;
  websiteUrl: string;
  createdAt: string;
}

export function addAuditToHistory(entry: AuditHistoryEntry) {
  if (typeof window === 'undefined') return;
  const existing = getAuditHistory();
  const updated = [entry, ...existing.filter((e) => e.auditId !== entry.auditId)].slice(0, 20);
  localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
}

export function getAuditHistory(): AuditHistoryEntry[] {
  if (typeof window === 'undefined') return [];
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}